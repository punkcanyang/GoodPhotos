{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "dialog:default",
    "fs:default",
    "fs:read-files",
    "fs:read-dirs",
    "fs:write-files",
    "fs:allow-mkdir",
    "process:default",
    "updater:default"
  ]
}
